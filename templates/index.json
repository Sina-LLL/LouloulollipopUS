    "testimonials_VgkpHw": {
      "type": "testimonials",
      "blocks": {
        "testimonial_dzeRxc": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial-title": "LOVE the bees!! 🐝",
            "testimonial": "Super soft, we love the fold over mitts and socks! Couldn’t be more in love with the pattern as well.",
            "author": "Stacey D",
            "image": "shopify://shop_images/6f343775-42fa-5aff-8245-6d9a0ec41c98.jpg",
            "image_caption": "",
            "link": "shopify://products/sleeper-bumble-bees"
          }
        },
        "testimonial_E6kGWU": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial-title": "Surprisingly soft",
            "testimonial": "I am really impressed with this bib! It is the softest waterproof bib we own by far; I don’t know how they managed to make it both soft and functional, but it is definitely both. The coverage is great on my petite two year old, keeping her nice and clean, and I love that I can just toss it in the washer. It makes it so much easier to get fully clean. The print is super cute too - I would definitely recommend it! I received this product as part of the Stellar Product Testing Panel in exchange for my honest review.",
            "author": "Anonymous",
            "image": "shopify://shop_images/22ab6ac7-6f8e-5b3b-a508-6bf3da54680e.jpg",
            "image_caption": "",
            "link": "shopify://products/long-sleeve-bib-sweet-treats"
          }
        },
        "testimonial_tqPcqL": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial-title": "Love these— go to sleep sack",
            "testimonial": "I absolutely love these sleep sacks and other LouLou products! The quality is fantastic and has endured many washes!! I aim to not put in dryer— one sack has gone in multiple times while the other I try to hang. I’m so impressed by how well these have stood up over the past 4 months of wear. A bit disappointed there’s no between size from the 0-6 and 6-18. My daughter is too petite to fit the next size for some time. It will be tough to be without our favourite sleep sack until she can.",
            "author": "Dcgilmr",
            "image": "shopify://shop_images/a6aa598a-c4b7-5ce4-a018-d67bd5c85bcb.jpg",
            "image_caption": "",
            "link": "shopify://collections/sleep-bags"
          }
        },
        "testimonial_3BMPQJ": {
          "type": "testimonial",
          "settings": {
            "star_rating": 5,
            "testimonial-title": "Softest Muslin",
            "testimonial": "Love these Muslim swaddles. I use them as lightweight and breathable summer blankets for my 8 month old. Large enough to cover his stroller for nap time or just to keep the sun off him. They are by far the softest I have found. Who wants to wrap their baby in scratchy muslin. Super cute designs too. Highly recommend.",
            "author": "Jasminetara",
            "image": "shopify://shop_images/500b5d60-9252-53bc-8df9-b53c73d4d475.jpg",
            "image_caption": "",
            "link": "shopify://products/muslin-swaddle-sushi"
          }
        }
      },
