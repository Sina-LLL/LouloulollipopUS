    "faq-content-1": {
      "type": "collapsible-tabs",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "How do I place an order?",
            "answer": "<p>You can place an order with Loulou Lollipop online through our website. If you have any issues placing your order, you can also <a href=\"https://louloulollipop.com/pages/contact-us\" title=\"Contact Us\">reach us</a> via live chat, email, or our contact form.</p>"
          }
        },
        "question_fw3TE8": {
          "type": "question",
          "settings": {
            "title": "My order is a gift, can I leave a gift note?",
            "answer": "<p>Yes!  You will have the option in your basket, prior to checkout.  Simply click “This is a gift” and add your text in the box.  We will also ensure no prices listed on the packing slip of your order.</p>"
          }
        },
        "question_FCFRxM": {
          "type": "question",
          "settings": {
            "title": "Do I need to create an account to order online?",
            "answer": "<p>While we encourage all customers to create an online account when ordering to take advantage of tracking orders and purchase history all in one place, you can always place an order as a “guest”.  Simply select “Checkout as Guest” when checking out to complete your order without creating an account.</p>"
          }
        },
        "question_6tCyXY": {
          "type": "question",
          "settings": {
            "title": "I’ve forgotten my account’s password. What should I do?",
            "answer": "<p>No worries!  You can easily reset your password by selecting “Forgot my Password” on the “<a href=\"https://louloulollipop.com/account/login\" title=\"/account/login\"><span style=\"text-decoration:underline\">Sign In</span></a>” page.  Enter your email address and we’ll sent you a link to reset your password shortly after.</p>"
          }
        },
        "question_LUzbQB": {
          "type": "question",
          "settings": {
            "title": "Can I see my order history?",
            "answer": "<p>Yes!  You can find your order history by logging into you <a href=\"https://louloulollipop.com/account\" title=\"/account\"><span style=\"text-decoration:underline\">Loulou Lollipop account </span></a>and viewing “Order History”.</p>"
          }
        },
        "question_ttE6MA": {
          "type": "question",
          "settings": {
            "title": "What forms of payment do you accept?",
            "answer": "<p>We accept Visa, Mastercard, American Express, Discover, PayPal, Google Pay, and Loulou Lollipop gift cards as payment.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "How do I use a promo code?",
            "answer": "<p>Occasionally we’ll send customers a special coupon to be used online.  These codes may come in an email directly or be shared on our <a href=\"https://www.instagram.com/louloulollipop/\" target=\"_blank\" title=\"LouLou Lollipop Instagram\"><span style=\"text-decoration:underline\">Instagram</span></a> page.  To redeem these codes, enter them in the “Gift card or discount code” box at the checkout page and click “Apply”.  Promo codes cannot be applied to previous purchases nor can we issue a price adjustment on purchases placed before the promotional period. <strong>Please also note that promo codes cannot be stacked, combined, or redeemed during promotional periods.</strong></p>"
          }
        }
      },
