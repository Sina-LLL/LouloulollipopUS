    "faq-content-2": {
      "type": "collapsible-tabs",
      "blocks": {
        "para-1": {
          "type": "content",
          "settings": {
            "content": "<p>All US orders over $75 ship for free! Shipping is $7 for orders under $75. If you need expedited shipping, the shipping fee will be calculated at checkout.</p>"
          }
        },
        "question-1": {
          "type": "question",
          "settings": {
            "title": "How long does shipping take?",
            "answer": "<p>When shipping within the continental United States, your order will arrive 5-10 business days after the order was placed.</p><p>Orders shipping to U.S. Territories and APO/FPO military sites may take additional transit time and cannot be expedited. Please allow up to 21 days for delivery.</p><p><strong>Please note that there will be shipping delays during sale periods and major holidays and this timeline cannot be guaranteed.</strong></p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Do you ship internationally?",
            "answer": "<p>Yes, we do!  International orders are shipped with tracking and cost is calculated at checkout, based on weight and destination country.</p><p>Items shipped internationally are subject to import custom duties and taxes. The recipient of the shipment is the importer of record and must comply with all applicable laws and regulations. The customer is responsible for paying all taxes and duties, should they occur.</p>"
          }
        }
      },
      "block_order": [
        "para-1",
        "question-1",
        "question-2"
      ],
      "settings": {
        "title": "Shipping Policy"
      }
    },
    "collapsible_tabs_CcLrBM": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_JXBdJD": {
          "type": "question",
          "settings": {
            "title": "What is Loulou Lollipop’s return policy?",
            "answer": "<p>We hope you love your items, but we understand that things don’t always work out.  We are happy to accept returns for items purchased on louloulollipop.com within 30 days from the date of purchase.  Items must be in unworn, unwashed, and unused condition with all original tags and packaging intact to be eligible for a refund.</p><p>Items marked “SALE” are not eligible for return or exchange.</p><p><strong>All purchases made during sales and promotional periods are final sale and cannot be returned or exchanged.</strong></p><p>All international shipments are considered final sale and are not eligible for return or exchange.</p>"
          }
        },
        "question_fqwjxq": {
          "type": "question",
          "settings": {
            "title": "How can I make a return or exchange?",
            "answer": "<p>Simply visit our <a href=\"https://louloulollipop.com/pages/returns\" title=\"Returns & Exchanges\">Returns Portal</a> to get started.  Upon submitting your online return or exchange, you will be provided with a return shipping label.  </p><p>If you included the Returns and Package Protection when you placed your order, your return or exchange can be done free of charge. If not, you may still make a return or exchange, but the return shipping will need to be paid for or will be deducted from the refund/credit amount.  We cannot refund original shipping fees.  Once the items are received back at our warehouse and processed, the credit will be issued, and any items for exchange will be shipped out. Please allow up to 14 days for your refund to be credited back to your account.</p>"
          }
        },
        "question_E6izyb": {
          "type": "question",
          "settings": {
            "title": "Can I return a gift?",
            "answer": "<p>Yes!  Visit our <a href=\"https://louloulollipop.com/pages/returns\" title=\"Returns & Exchanges\"><span style=\"text-decoration:underline\">Returns Portal</span></a> and choose “Returning a gift?”.</p>"
          }
        },
        "question_GdcNLX": {
          "type": "question",
          "settings": {
            "title": "Can I return select items from my bundle or gift set?",
            "answer": "<p>Please include all original unwashed, unworn items with the original tags and packaging from the bundle or gift set. We are unable to process the return without all of the original items in the set or bundle.</p>"
          }
        },
        "question_dLnhVL": {
          "type": "question",
          "settings": {
            "title": "What should I do if an item is damaged or defective?",
            "answer": "<p>If your order was incorrectly shipped or an item is damaged, please <a href=\"https://louloulollipop.com/pages/contact-us\" title=\"Contact Us\"><span style=\"text-decoration:underline\">reach out to us</span></a> within 7 days of delivery so we can help sort it out!</p><p>If you believe your item is faulty, or otherwise defective, we offer a 3-month warranty* from the date of purchase and would be happy to help you replace the item.  Contact us <a href=\"https://louloulollipop.com/pages/contact-us\" title=\"Contact Us\"><span style=\"text-decoration:underline\">here</span></a> and our customer support team will take care of you.  </p><p><em>*Warranty applies only to manufacturers defects and </em><em><strong>does not</strong></em><em> cover normal wear and tear or improper use.  Please follow the cleaning & care instructions located on the product packaging or care tag(s) to ensure the longevity of your items. Pacifier clips </em><em><strong>cannot</strong></em><em> be sterilized.</em></p>"
          }
        }
      },
