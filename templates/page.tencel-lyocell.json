          "settings": {
            "enable_media": true,
            "image": "shopify://shop_images/KA1003U.PCK_Waffle_2-pc_Pajama_Set_Peacock_6_26d1a114-24dc-445a-9d36-5feb92df9a7a.jpg",
            "title": "It’s temperature regulating and moisture wicking  ",
            "text": "<p>TENCEL is naturally wicking and breathable, keeping babies and toddlers warm in the winter and cool and dry in the summer. And that means better sleep for everyone.  </p>",
            "button_label": "",
            "link": ""
