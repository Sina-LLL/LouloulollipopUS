        "question_6CMP6c": {
          "type": "question",
          "settings": {
            "title": "How will I know when I have made a sale?",
            "answer": "<p>You will receive an email each time you make a sale. Check your dashboard via your storefront to see and track your full sales/commission stats at any point.</p>"
          }
        },
        "question_LtktMM": {
          "type": "question",
          "settings": {
            "title": "When will I recieve my commission?",
            "answer": "<p>You will receive an email from Tremendous with a link to receive your monthly commission on the first business week of the following month.</p>"
          }
        },
        "question_Lk76K3": {
          "type": "question",
          "settings": {
            "title": "How do I edit the products on my page?",
            "answer": "<p>Log into your storefront and click the '+ Add' button on the page to pick individual products or create a collection of products to feature on your storefront.</p>"
          }
        },
        "question_gAUnJp": {
          "type": "question",
          "settings": {
            "title": "Where do I view my affiliate stats?",
            "answer": "<p>Log into your storefront and click the 'View my dashboard' button to access your dashboard. You will be able to see commission stats (i.e. approved sales, sales amount, commissions earned) and social stats (i.e. number of approved/rejected posts) each month.</p>"
          }
        },
        "question_zNkMK9": {
          "type": "question",
          "disabled": true,
          "settings": {
            "title": "Who can I contact with questions?",
            "answer": "<p>Reach out to <a href=\"mailto:customercare@louloulollipop.ca\" target=\"_blank\" title=\"mailto:customercare@louloulollipop.ca\">customercare@louloulollipop.ca</a> with questions regarding your storefront or program activity.</p>"
          }
        }
      },
