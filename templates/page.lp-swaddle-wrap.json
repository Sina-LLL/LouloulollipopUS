    "care": {
      "type": "collapsible-tabs",
      "blocks": {
        "wash": {
          "type": "question",
          "settings": {
            "title": "How do I wash the Swaddle Wrap?",
            "answer": "<p>Machine wash cold with like colors on a gentle cycle, and tumble dry on low heat. Use only non-chlorine bleach, don't dry clean, and don't iron the printed areas. TENCEL™ is built for the two or three washes a week that baby laundry demands.</p>"
          }
        },
        "size": {
          "type": "question",
          "settings": {
            "title": "What size is it?",
            "answer": "<p>The Swaddle Wrap is sized for 0–4 months. It should be snug around the chest and roomy at the hips and legs.</p>"
          }
        },
        "layers": {
          "type": "question",
          "settings": {
            "title": "What should my baby wear underneath?",
            "answer": "<p>At 1.0 TOG in a 70–75°F room, a long-sleeve bodysuit or fitted sleeper is usually right. Check the back of baby's neck or chest: it should feel warm and dry, not hot or sweaty.</p>"
          }
        }
      },
      "block_order": [
