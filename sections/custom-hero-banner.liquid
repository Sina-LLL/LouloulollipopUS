{%- comment -%}
  Custom hero banner
  Single image hero with separate desktop and mobile images.
  - Image is shown with object-fit: contain so nothing is cropped (text baked
    into the image stays fully visible at any width).
  - The section height follows the natural height of the image (height: auto),
    so it is never letterboxed and never cropped.
  - Uses the theme's 'image-desktop-and-mobile' snippet for the responsive
    <picture> (desktop <img> + mobile <source>), srcset and focal point.
  - Styling is in assets/design-system.css (.custom-hero-banner*). The only
    dynamic value, max image width, is passed via the --custom-hero-max-width
    CSS variable below.
{%- endcomment -%}

{%- liquid
  assign has_link = false
  if section.settings.link != blank
    assign has_link = true
  endif
-%}

<div
  id="custom-hero-{{ section.id }}"
  class="custom-hero-banner"
  {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}
>
  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  {%- if has_link -%}
    <a class="custom-hero-banner__link" href="{{ section.settings.link }}">
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    {%- if section.settings.use_h1 -%}
      <h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>
    {%- else -%}
      <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  {%- endif -%}

  <div
    class="custom-hero-banner__media"
    {%- if section.settings.max_width > 0 %} style="--custom-hero-max-width: {{ section.settings.max_width }}px"{% endif %}
  >
    {%- if section.settings.image == blank and section.settings.mobile_image == blank -%}
      <div class="placeholder-image">
        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
      </div>
    {%- else -%}
      {%- render 'image-desktop-and-mobile',
        class: 'custom-hero-banner__img',
        desktop_image: section.settings.image,
        mobile_image: section.settings.mobile_image,
        loading: 'eager',
        fetchpriority: 'high'
      -%}
    {%- endif -%}
  </div>

  {%- if has_link -%}
    </a>
  {%- endif -%}

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Custom Hero Banner",
  "class": "section-custom-hero-banner",
  "disabled_on": {
    "groups": ["aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A single full-width image that is never cropped. Best for images that already contain text. Set the image's alt text in Shopify for accessibility and SEO."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Shown on screens 768px and wider."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Shown below 768px. Falls back to the desktop image if left empty."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image link",
      "info": "Optional. Wraps the whole banner in a link."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 2560,
      "step": 40,
      "unit": "px",
      "label": "Maximum image width",
      "info": "0 = no limit. Prevents the image upscaling on very wide screens.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Accessibility / SEO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hidden heading",
      "info": "Optional. Read by screen readers and search engines but not shown on screen (the text is in the image)."
    },
    {
      "type": "checkbox",
      "id": "use_h1",
      "label": "Set hidden heading as primary page heading (H1)",
      "info": "Use one H1 per page.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
