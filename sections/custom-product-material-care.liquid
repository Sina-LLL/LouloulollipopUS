{% schema %}
{
  "name": "Custom Material & Care",
  "tag": "section",
  "class": "custom-product-material-care",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Material & Care"
    },
    {
      "type": "image_picker",
      "id": "care_image",
      "label": "Care Image"
    }
  ],
  "presets": [
    {
      "name": "Custom Material & Care",
      "category": "Product"
    }
  ]
}
{% endschema %}
