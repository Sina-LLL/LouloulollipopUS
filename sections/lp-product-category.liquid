{%- liquid
  assign lp_col = collections[section.settings.collection_handle]
-%}

<div class="lpc" id="lpc-{{ section.id }}">

  {%- comment -%} HERO {%- endcomment -%}
  <div class="lpc-hero">
    <div class="lpc-hero__media">
      {%- if section.settings.hero_image != blank -%}
        {{- section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
                class: 'lpc-hero__img',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '600, 800, 1000, 1200',
                sizes: '(min-width: 860px) 60vw, 100vw'
        -}}
      {%- else -%}
        {{ 'collection-3' | placeholder_svg_tag: 'lpc-hero__img lpc-hero__img--ph' }}
      {%- endif -%}
    </div>
    <div class="lpc-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lpc-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="lpc-hero__heading">{{ section.settings.headline }}</h1>
      {%- if section.settings.subheadline != blank -%}
        <p class="lpc-hero__sub">{{ section.settings.subheadline }}</p>
      {%- endif -%}
      {%- if lp_col != blank -%}
        <a href="{{ lp_col.url }}" class="lpc-btn lpc-btn--solid">
          {{ section.settings.cta_label | default: 'Shop Now' }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} FEATURES {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="lpc-features">
      <div class="lpc-features__inner">
        {%- if section.settings.features_heading != blank -%}
          <h2 class="lpc-features__heading">{{ section.settings.features_heading }}</h2>
        {%- endif -%}
        <div class="lpc-features__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="lpc-feature" {{ block.shopify_attributes }}>
                <span class="lpc-feature__num">0{{ forloop.index }}</span>
                <h3 class="lpc-feature__title">{{ block.settings.heading }}</h3>
                {%- if block.settings.body != blank -%}
                  <p class="lpc-feature__body">{{ block.settings.body }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} MATERIALS {%- endcomment -%}
  {%- if section.settings.materials_heading != blank or section.settings.materials_body != blank -%}
    <div class="lpc-materials">
      <div class="lpc-materials__inner">
        <div class="lpc-materials__text">
          {%- if section.settings.materials_heading != blank -%}
            <h2 class="lpc-materials__heading">{{ section.settings.materials_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.materials_body != blank -%}
            <div class="lpc-materials__body rte">{{ section.settings.materials_body }}</div>
          {%- endif -%}
          {%- if lp_col != blank -%}
            <a href="{{ lp_col.url }}" class="lpc-btn lpc-btn--outline">
              {{ section.settings.cta_label | default: 'Shop Now' }}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.materials_image != blank -%}
          <div class="lpc-materials__media">
            {{- section.settings.materials_image
                | image_url: width: 700
                | image_tag:
                    class: 'lpc-materials__img',
                    loading: 'lazy',
                    widths: '400, 600, 700',
                    sizes: '(min-width: 860px) 40vw, 100vw'
            -}}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} PRODUCTS {%- endcomment -%}
  {%- if lp_col != blank and lp_col.products_count > 0 -%}
    <div class="lpc-products">
      <div class="lpc-products__inner">
        <h2 class="lpc-products__heading">{{ section.settings.products_heading | default: 'Best Sellers' }}</h2>
        <div class="lpc-products__grid">
          {%- for product in lp_col.products limit: 4 -%}
            <a href="{{ product.url }}" class="lpc-product-card">
              <div class="lpc-product-card__img-wrap">
                {%- if product.featured_image != blank -%}
                  {{- product.featured_image
                      | image_url: width: 600
                      | image_tag:
                          class: 'lpc-product-card__img',
                          loading: 'lazy',
                          widths: '300, 450, 600',
                          sizes: '(min-width: 860px) 25vw, 50vw',
                          alt: product.title
                  -}}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'lpc-product-card__img' }}
                {%- endif -%}
              </div>
              <div class="lpc-product-card__info">
                <p class="lpc-product-card__title">{{ product.title }}</p>
                <p class="lpc-product-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          {%- endfor -%}
        </div>
        <div class="lpc-products__footer">
          <a href="{{ lp_col.url }}" class="lpc-btn lpc-btn--solid">
            View All {{ lp_col.title }}
          </a>
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

<style>
  .lpc { font-family: var(--base-font-family); color: var(--color-text); }

  .lpc-hero { display: grid; grid-template-columns: 1fr; min-height: 60vh; }
  .lpc-hero__media { position: relative; overflow: hidden; }
  .lpc-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 320px; }
  .lpc-hero__img--ph svg { width: 100%; height: 100%; min-height: 320px; }
  .lpc-hero__content {
    display: flex; flex-direction: column; justify-content: center;
    padding: 48px 32px; background: #faf9f7; order: -1;
  }
  .lpc-hero__eyebrow { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; margin: 0 0 14px; }
  .lpc-hero__heading {
    font-family: var(--heading-font-family); font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style); letter-spacing: var(--heading-font-letter-spacing);
    font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1.15; margin: 0 0 16px;
  }
  .lpc-hero__sub { font-size: 1rem; line-height: 1.65; opacity: .75; margin: 0 0 28px; max-width: 420px; }

  .lpc-btn {
    display: inline-block; text-decoration: none; font-size: .8rem; font-weight: 600;
    letter-spacing: .09em; text-transform: uppercase; padding: 14px 32px; border-radius: 3px;
    transition: background .2s, color .2s; cursor: pointer; align-self: flex-start;
  }
  .lpc-btn--solid { background: var(--color-text); color: #fff; border: 1.5px solid var(--color-text); }
  .lpc-btn--solid:hover { opacity: .82; }
  .lpc-btn--outline { background: transparent; color: var(--color-text); border: 1.5px solid var(--color-text); }
  .lpc-btn--outline:hover { background: var(--color-text); color: #fff; }

  .lpc-features { padding: 64px 24px; background: #fff; }
  .lpc-features__inner { max-width: 960px; margin: 0 auto; }
  .lpc-features__heading {
    font-family: var(--heading-font-family); font-weight: var(--heading-font-weight);
    letter-spacing: var(--heading-font-letter-spacing);
    font-size: clamp(1.3rem, 3vw, 1.9rem); text-align: center; margin: 0 0 48px;
  }
  .lpc-features__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 56px; }
  .lpc-feature__num { display: block; font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; opacity: .3; margin-bottom: 10px; font-weight: 700; }
  .lpc-feature__title {
    font-family: var(--heading-font-family); font-weight: var(--heading-font-weight);
    letter-spacing: var(--heading-font-letter-spacing); font-size: 1rem; margin: 0 0 8px;
  }
  .lpc-feature__body { font-size: .88rem; line-height: 1.7; opacity: .68; margin: 0; }

  .lpc-materials { padding: 64px 24px; background: #f4f1ec; }
  .lpc-materials__inner { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  .lpc-materials__heading {
    font-family: var(--heading-font-family); font-weight: var(--heading-font-weight);
    letter-spacing: var(--heading-font-letter-spacing);
    font-size: clamp(1.3rem, 3vw, 1.9rem); margin: 0 0 16px;
  }
  .lpc-materials__body { font-size: .95rem; line-height: 1.8; opacity: .8; margin: 0 0 28px; }
  .lpc-materials__body p { margin: 0 0 12px; }
  .lpc-materials__img { width: 100%; border-radius: 8px; display: block; }

  .lpc-products { padding: 64px 24px; background: #fff; }
  .lpc-products__inner { max-width: 1040px; margin: 0 auto; }
  .lpc-products__heading {
    font-family: var(--heading-font-family); font-weight: var(--heading-font-weight);
    letter-spacing: var(--heading-font-letter-spacing);
    font-size: clamp(1.3rem, 3vw, 1.9rem); text-align: center; margin: 0 0 40px;
  }
  .lpc-products__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
  .lpc-product-card { display: block; text-decoration: none; color: inherit; }
  .lpc-product-card__img-wrap { aspect-ratio: 4/5; overflow: hidden; border-radius: 8px; background: #f7f5f2; margin-bottom: 12px; }
  .lpc-product-card__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .lpc-product-card:hover .lpc-product-card__img { transform: scale(1.04); }
  .lpc-product-card__title { font-size: .9rem; font-weight: 600; margin: 0 0 4px; line-height: 1.4; }
  .lpc-product-card__price { font-size: .85rem; opacity: .65; margin: 0; }
  .lpc-products__footer { text-align: center; }

  @media (min-width: 860px) {
    .lpc-hero { grid-template-columns: 2fr 3fr; min-height: 70vh; }
    .lpc-hero__content { order: 0; padding: 64px 56px; }
    .lpc-materials__inner { grid-template-columns: 1fr 1fr; }
    .lpc-products__grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 580px) {
    .lpc-hero__content { padding: 36px 20px; }
    .lpc-features { padding: 48px 20px; }
    .lpc-features__grid { grid-template-columns: 1fr; gap: 28px; }
    .lpc-materials { padding: 48px 20px; }
    .lpc-products { padding: 48px 20px; }
    .lpc-products__grid { gap: 14px; }
  }
</style>

{% schema %}
{
  "name": "Product Category LP",
  "settings": [
    { "type": "text",         "id": "collection_handle", "label": "Collection handle" },
    { "type": "text",         "id": "eyebrow",           "label": "Eyebrow text",         "default": "Non-Toxic · Canadian · Award-Winning" },
    { "type": "text",         "id": "headline",          "label": "Headline",             "default": "Premium Baby Essentials" },
    { "type": "textarea",     "id": "subheadline",       "label": "Subheadline" },
    { "type": "image_picker", "id": "hero_image",        "label": "Hero image" },
    { "type": "text",         "id": "cta_label",         "label": "CTA button label",     "default": "Shop Now" },
    { "type": "text",         "id": "features_heading",  "label": "Features heading",     "default": "Why Parents Love It" },
    { "type": "text",         "id": "materials_heading", "label": "Materials heading",    "default": "What It’s Made Of" },
    { "type": "richtext",     "id": "materials_body",    "label": "Materials description" },
    { "type": "image_picker", "id": "materials_image",   "label": "Materials image (optional)" },
    { "type": "text",         "id": "products_heading",  "label": "Products heading",     "default": "Best Sellers" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text",     "id": "heading", "label": "Feature name",        "default": "Feature" },
        { "type": "textarea", "id": "body",    "label": "Feature description" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product Category LP" }]
}
{% endschema %}