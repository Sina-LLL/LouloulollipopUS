{%- if localization.available_countries.size > 1 -%}
  {%- liquid
    assign id = section.id | append: '-country'
    assign filtered_countries = localization.available_countries | where: "iso_code", "US"
    assign ca_country = localization.available_countries | where: "iso_code", "CA"
    assign filtered_countries = filtered_countries | concat: ca_country

    capture country_values
      for country in filtered_countries
        echo country.iso_code
        echo '|'
      endfor
    endcapture
  -%}

  {%- capture country_names -%}
    {%- for country in filtered_countries -%}
      <span class="country-option">
        <span class="country-option__name">{{ country.name }}</span>
        <span class="country-option__currency">
          ({% if country.iso_code == "CA" %}CAD&nbsp;${% else %}{{ country.currency.iso_code }}&nbsp;{{ country.currency.symbol }}{% endif %})
        </span>
      </span>|
    {%- endfor -%}
  {%- endcapture -%}


  {%- liquid
    assign country_values = country_values | remove_last: '|' | split: '|'
    assign country_names = country_names | remove_last: '|' | split: '|'
  -%}

  {%- render 'custom-select',
    id: id,
    option_values: country_values,
    option_names: country_names,
    selected_value: localization.country.iso_code
  -%}
{%- endif -%}
