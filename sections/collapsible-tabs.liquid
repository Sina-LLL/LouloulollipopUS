{{ 'collapsible-tabs.css' | asset_url | stylesheet_tag }}
<div class="container" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
  <div class="collapsible-tabs">
    {% if section.settings.title != blank and section.blocks != blank %}
      <h3 class="collapsible-tabs__heading collapsible-tabs__content" id="faq-{{ section.settings.title | handle }}">{{ section.settings.title | escape }}</h3>
    {% endif %}

    {%- for block in section.blocks -%}
      <div class="collapsible-tabs__block" {{ block.shopify_attributes }}>
        {% if block.type == 'content' %}
          <div class="collapsible-tabs__text collapsible-tabs__content rte">{{ block.settings.content }}</div>

        {% elsif block.type == 'button' %}
          <div class="collapsible-tabs__button collapsible-tabs__content">
            <a class="btn btn--primary btn--link" href="{{ block.settings.link }}"><span class="btn__text">{{ block.settings.title | escape }}</span></a>
          </div>

        {% elsif block.type == 'question' %}
          <div class="collapsible-tabs__tab">
            <details-disclosure>
              <details class="disclosure">
                <summary class="disclosure__title">
                  {{- block.settings.title | escape -}}
                </summary>
                <div class="disclosure__panel has-motion">
                  <div class="disclosure__content rte">
                    {{- block.settings.answer -}}
                  </div>
                </div>
              </details>
            </details-disclosure>
          </div>
        {% endif %}
      </div>
    {%- endfor -%}
  </div>
</div>

{%- assign question_blocks = section.blocks | where: 'type', 'question' -%}
{%- assign faq_count = 0 -%}
{% capture faq_entities_json %}
  {%- for block in question_blocks -%}
    {%- assign faq_question = block.settings.title | strip_html | strip -%}
    {%- assign faq_answer = block.settings.answer | strip_html | replace: '&nbsp;', ' ' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&amp;', '&' | strip_newlines | strip -%}
    {%- if faq_question != blank and faq_answer != blank -%}
      {%- if faq_count > 0 -%},{%- endif -%}
      {%- assign faq_count = faq_count | plus: 1 -%}
      {
        "@type": "Question",
        "name": {{ faq_question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faq_answer | json }}
        }
      }
    {%- endif -%}
  {%- endfor -%}
{% endcapture %}
{%- if section.settings.output_faq_schema and faq_count > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{{ faq_entities_json }}]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collapsible tabs",
  "class": "section-collapsible-tabs",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collapsible tabs"
    },
    {
      "type": "checkbox",
      "id": "output_faq_schema",
      "label": "Output FAQ structured data",
      "info": "Google allows one FAQPage per page. Uncheck on all but one collapsible tabs section per page.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    },
    {
      "type": "content",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible tabs",
      "settings": {
      },
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
