<section class="lp-cats" id="lp-cats-{{ section.id }}">
  {%- if section.settings.headline != blank or section.settings.subheadline != blank -%}
    <div class="lp-cats__header">
      {%- if section.settings.headline != blank -%}
        <h1 class="lp-cats__headline">{{ section.settings.headline }}</h1>
      {%- endif -%}
      {%- if section.settings.subheadline != blank -%}
        <p class="lp-cats__subheadline">{{ section.settings.subheadline }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="lp-cats__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url }}" class="lp-cat-card" {{ block.shopify_attributes }}>
        <div class="lp-cat-card__img-wrap">
          {%- if block.settings.image != blank -%}
            {%- liquid
              if forloop.index <= 2
                assign img_loading = 'eager'
                assign img_fetchpriority = 'high'
              else
                assign img_loading = 'lazy'
                assign img_fetchpriority = 'low'
              endif
            -%}
            {{- block.settings.image
                | image_url: width: 900
                | image_tag:
                    class: 'lp-cat-card__img',
                    loading: img_loading,
                    fetchpriority: img_fetchpriority,
                    widths: '400, 600, 800, 900',
                    sizes: '(min-width: 768px) 50vw, 100vw'
            -}}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'lp-cat-card__img lp-cat-card__img--ph' }}
          {%- endif -%}
        </div>
        <div class="lp-cat-card__body">
          <h2 class="lp-cat-card__title">{{ block.settings.heading }}</h2>
          {%- if block.settings.subheading != blank -%}
            <p class="lp-cat-card__sub">{{ block.settings.subheading }}</p>
          {%- endif -%}
          <span class="lp-cat-card__btn">{{ block.settings.cta_label | default: 'Shop Now' }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
  .lp-cats{
    padding:48px 24px 64px;
    max-width:1200px;
    margin:0 auto;
  }
  .lp-cats__header{
    text-align:center;
    margin-bottom:40px;
    max-width:640px;
    margin-left:auto;margin-right:auto;
  }
  .lp-cats__headline{
    font-family:var(--heading-font-family);
    font-weight:var(--heading-font-weight);
    font-style:var(--heading-font-style);
    letter-spacing:var(--heading-font-letter-spacing);
    font-size:clamp(1.8rem,4vw,2.8rem);
    margin:0 0 12px;
    color:var(--color-text);
  }
  .lp-cats__subheadline{
    font-size:1.05rem;
    color:var(--color-text);
    opacity:.65;
    margin:0;
    line-height:1.6;
  }
  .lp-cats__grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  .lp-cat-card{
    display:block;
    text-decoration:none;
    color:inherit;
    border-radius:12px;
    overflow:hidden;
    background:#f7f5f2;
    transition:transform .25s ease,box-shadow .25s ease;
  }
  .lp-cat-card:hover{
    transform:translateY(-4px);
    box-shadow:0 14px 36px rgba(0,0,0,.11);
  }
  .lp-cat-card__img-wrap{
    aspect-ratio:4/5;
    overflow:hidden;
  }
  .lp-cat-card__img{
    width:100%;height:100%;
    object-fit:cover;display:block;
    transition:transform .45s ease;
  }
  .lp-cat-card:hover .lp-cat-card__img{
    transform:scale(1.04);
  }
  .lp-cat-card__img--ph svg{width:100%;height:100%;}
  .lp-cat-card__body{
    padding:22px 20px 24px;
    text-align:center;
  }
  .lp-cat-card__title{
    font-family:var(--heading-font-family);
    font-weight:var(--heading-font-weight);
    font-style:var(--heading-font-style);
    letter-spacing:var(--heading-font-letter-spacing);
    font-size:clamp(1.1rem,2.5vw,1.45rem);
    margin:0 0 8px;
    color:var(--color-text);
  }
  .lp-cat-card__sub{
    font-size:.9rem;
    color:var(--color-text);
    opacity:.6;
    margin:0 0 18px;
    line-height:1.55;
  }
  .lp-cat-card__btn{
    display:inline-block;
    font-size:.78rem;
    letter-spacing:.1em;
    text-transform:uppercase;
    font-weight:600;
    padding:10px 26px;
    border:1.5px solid var(--color-text);
    border-radius:3px;
    color:var(--color-text);
    transition:background .2s ease,color .2s ease;
  }
  .lp-cat-card:hover .lp-cat-card__btn{
    background:var(--color-text);
    color:#fff;
  }
  @media(max-width:580px){
    .lp-cats{padding:32px 16px 48px;}
    .lp-cats__grid{grid-template-columns:1fr;gap:16px;}
    .lp-cat-card__img-wrap{aspect-ratio:3/2;}
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    { "type": "text",  "id": "headline",    "label": "Headline",    "default": "Shop Our Hero Products" },
    { "type": "text",  "id": "subheadline", "label": "Subheadline", "default": "Premium sleep and feeding essentials designed for your little one." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image"         },
        { "type": "text",         "id": "heading",    "label": "Name",         "default": "Sleep Bags" },
        { "type": "text",         "id": "subheading", "label": "Value prop",   "default": "Safer sleep from newborn to big kid." },
        { "type": "url",          "id": "url",        "label": "Link"          },
        { "type": "text",         "id": "cta_label",  "label": "Button label", "default": "Shop Now" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Category Grid" }]
}
{% endschema %}