{%- comment -%}
  Full-width video banner (edge to edge, like the collection header image). Autoplays muted on loop.
  The video is cropped to the banner height; use "Video focus" to choose which part stays in view.
{%- endcomment -%}
{%- liquid
  assign v = section.settings.video
  assign h_desk = section.settings.height_desktop
  assign h_mob = section.settings.height_mobile
  assign has_text = false
  if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank
    assign has_text = true
  endif
-%}
{%- if v != blank -%}
<div class="cvb" style="--cvb-h: {{ h_desk }}px; --cvb-h-mob: {{ h_mob }}vh; --cvb-focus: center {{ section.settings.focus }}%; --cvb-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="cvb__media">
    {{ v | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', class: 'cvb__video', image_size: '1500x' }}
  </div>
  {%- if has_text -%}
    <div class="cvb__overlay cvb__overlay--{{ section.settings.text_position }}">
      <div class="cvb__text">
        {%- if section.settings.heading != blank -%}<h2 class="cvb__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="cvb__body rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="btn btn--primary cvb__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Full-width video banner",
  "class": "section-cvb",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "range", "id": "height_desktop", "label": "Height on desktop", "min": 240, "max": 800, "step": 20, "unit": "px", "default": 480 },
    { "type": "range", "id": "height_mobile", "label": "Height on mobile", "min": 30, "max": 90, "step": 5, "unit": "vh", "default": 60 },
    { "type": "range", "id": "focus", "label": "Video focus (top to bottom)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "info": "Which part of the video stays in view when it is cropped." },
    { "type": "header", "content": "Text (optional)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "text_position", "label": "Text position", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "range", "id": "overlay", "label": "Darken video behind text", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 }
  ],
  "presets": [{ "name": "Full-width video banner" }]
}
{% endschema %}
