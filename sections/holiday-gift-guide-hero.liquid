<section class="hgg-hero" id="section-id-{{ section.id }}">
  <div class="container hgg-hero__inner{% if section.settings.image == blank %} hgg-hero__inner--no-media{% endif %}">
    <div class="hgg-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hgg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hgg-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hgg-hero__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.deadline_text != blank -%}
        <p class="hgg-hero__deadline">{{ section.settings.deadline_text }}</p>
      {%- endif -%}
      <div class="hgg-hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--secondary" href="{{ section.settings.button2_link | default: '#holiday-deadlines' }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <nav class="hgg-price" aria-label="{{ section.settings.price_label | escape }}">
          {%- if section.settings.price_label != blank -%}<p class="hgg-price__label">{{ section.settings.price_label | escape }}</p>{%- endif -%}
          <ul class="hgg-price__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><a class="hgg-price__pill" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="hgg-hero__media">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', class: 'hgg-hero__img' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Holiday gift guide hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Holiday Gift Guide" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Gifts for the littlest people on your list" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "inline_richtext", "id": "deadline_text", "label": "Deadline line", "info": "Shown under the text. Update or clear it as deadlines pass." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop top gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Shipping deadlines" },
    { "type": "text", "id": "button2_link", "label": "Second button link", "default": "#holiday-deadlines", "info": "Use #holiday-deadlines to jump to the deadlines section." },
    { "type": "text", "id": "price_label", "label": "Price links heading", "default": "Shop by price" }
  ],
  "blocks": [
    {
      "type": "price_link",
      "name": "Price link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Under $50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Holiday gift guide hero" }]
}
{% endschema %}
