{% comment %}
  Parameters:
  - product {Object} - Product object.
  - product_form_id {String} - Product form ID.
  - media_ratio {Number} - Media aspect ratio.
  - block {Object} - Block object.
  - dynamic_availability_mode {String} - Dynamic availability mode, 'selection' or 'down', default is 'selection'.

  Dependencies:
  - Custom select component

  Usage:
  {% render 'variant-picker', product: product, product_form_id: product_form_id, block: block %}
{% endcomment %}



{% liquid
  assign has_siblings = false
  if product.metafields.theme.siblings.value != blank and product.metafields.theme.siblings.type == 'single_line_text_field'
    assign has_siblings = true
    assign cutline = product.metafields.theme.cutline
    assign sibs_collection = collections[product.metafields.theme.siblings.value]
  endif
%}

{% if has_siblings %}

  {% comment %} Determine which categories exist {% endcomment %}
  {%- assign has_new_prints = false -%}
  {%- assign has_core_prints = false -%}
  {%- assign has_sale_prints = false -%}

  {%- for sibling in sibs_collection.products -%}
    {%- unless sibling.tags contains 'hidden' -%}
      {%- if sibling.tags contains 'new' -%}
        {%- assign has_new_prints = true -%}
      {%- endif -%}
      {%- if sibling.tags contains 'core' -%}
        {%- assign has_core_prints = true -%}
      {%- endif -%}
      {%- if sibling.tags contains 'sale' -%}
        {%- assign has_sale_prints = true -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}

  {% comment %} Count how many categories exist to decide if "All" tab is needed {% endcomment %}
  {%- assign category_count = 0 -%}
  {%- if has_new_prints -%}{%- assign category_count = category_count | plus: 1 -%}{%- endif -%}
  {%- if has_core_prints -%}{%- assign category_count = category_count | plus: 1 -%}{%- endif -%}
  {%- if has_sale_prints -%}{%- assign category_count = category_count | plus: 1 -%}{%- endif -%}

  {%- assign show_all_tab = false -%}
  {%- if category_count > 1 -%}
    {%- assign show_all_tab = true -%}
  {%- endif -%}

  <div class="sibling-tabs" data-sibling-tabs>

    {% comment %} Tab Buttons {% endcomment %}
    <div class="sibling-tabs__nav" role="tablist">
      {%- if show_all_tab -%}
        <button
          class="sibling-tabs__tab is-active"
          role="tab"
          aria-selected="true"
          data-tab="all">
          All
        </button>
      {%- endif -%}
      {%- if has_new_prints -%}
        <button
          class="sibling-tabs__tab{% unless show_all_tab %} is-active{% endunless %}"
          role="tab"
          aria-selected="{% unless show_all_tab %}true{% else %}false{% endunless %}"
          data-tab="new">
          Seasonal
        </button>
      {%- endif -%}
      {%- if has_core_prints -%}
        <button
          class="sibling-tabs__tab{% unless show_all_tab or has_new_prints %} is-active{% endunless %}"
          role="tab"
          aria-selected="{% unless show_all_tab or has_new_prints %}true{% else %}false{% endunless %}"
          data-tab="core">
          Core
        </button>
      {%- endif -%}
      {%- if has_sale_prints -%}
        <button
          class="sibling-tabs__tab{% unless show_all_tab or has_new_prints or has_core_prints %} is-active{% endunless %}"
          role="tab"
          aria-selected="{% unless show_all_tab or has_new_prints or has_core_prints %}true{% else %}false{% endunless %}"
          data-tab="sale">
          Sale
        </button>
      {%- endif -%}
    </div>

    {% comment %} Shared color name display {% endcomment %}
    <div class="sibling-tabs__color-label">
      <span class="product-form label js-color-label-prefix">Style: </span>
      <span class="product-form option-selector__label-value js-color-label-value">{{ sibling.metafields.theme.cutline }}</span>
    </div>

    {% comment %} Tab Panels {% endcomment %}

    {%- if show_all_tab -%}
      <div class="sibling-tabs__panel is-active" data-panel="all" role="tabpanel">
        <div class="option-selector__btns variant-grid-compact">

          {% comment %} 1: New — in stock {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- if sibling.tags contains 'new' and sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="opt-label__tag product-label--new">NEW</div>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} 2: Core (not new, not sale) — in stock {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- unless sibling.tags contains 'new' or sibling.tags contains 'sale' -%}
                {%- if sibling.available -%}
                  <a href="{{ sibling.url }}"
                    class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                    data-color="{{ sibling.metafields.theme.cutline }}"
                    {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                    <div class="overflow_hidden">
                      <div class="opt-label__media media">
                        {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                          {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- else -%}
                          {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} 3: Sale — in stock {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- if sibling.tags contains 'sale' and sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="opt-label__tag product-label--sale">SALE</div>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} 4: All sold out — last {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- unless sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image sold-out {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      <div class="sold-out-line"></div>
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}

        </div>
      </div>
    {%- endif -%}

    {%- if has_new_prints -%}
      <div class="sibling-tabs__panel{% unless show_all_tab %} is-active{% endunless %}" data-panel="new" role="tabpanel">
        <div class="option-selector__btns variant-grid-compact">
          {% comment %} Seasonal Tab - New prints {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- if sibling.tags contains 'new' and sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="opt-label__tag product-label--new">NEW</div>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} Seasonal Tab - Seasonal prints (not Core) {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- if sibling.tags contains 'Seasonal' and sibling.available-%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} Seasonal Tab - Sold Out {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' and sibling.available -%}
              {%- unless sibling.available -%}
                {%- if sibling.tags contains 'Seasonal' or sibling.tags contains 'new'-%}
                  <a href="{{ sibling.url }}"
                    class="opt-label opt-label--image sold-out {% if sibling.handle == product.handle %}is-active{% endif %}"
                    data-color="{{ sibling.metafields.theme.cutline }}"
                    {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                    <div class="overflow_hidden">
                      <div class="opt-label__media media">
                        <div class="sold-out-line"></div>
                        {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                          {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- else -%}
                          {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if has_core_prints -%}
      <div class="sibling-tabs__panel{% unless show_all_tab or has_new_prints %} is-active{% endunless %}" data-panel="core" role="tabpanel">
        <div class="option-selector__btns variant-grid-compact">

          {% comment %} Core Tab - Core prints {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' or  sibling.tags contains 'new' or  sibling.tags contains 'sale'-%}
              {%- if sibling.tags contains 'core' and sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

  

          {% comment %} Core Tab - sold out prints {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' and sibling.available -%}
              {%- unless sibling.available -%}
                {%- if sibling.tags contains 'core' -%}
                  <a href="{{ sibling.url }}"
                    class="opt-label opt-label--image sold-out {% if sibling.handle == product.handle %}is-active{% endif %}"
                    data-color="{{ sibling.metafields.theme.cutline }}"
                    {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                    <div class="overflow_hidden">
                      <div class="opt-label__media media">
                        <div class="sold-out-line"></div>
                        {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                          {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- else -%}
                          {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if has_sale_prints -%}
      <div class="sibling-tabs__panel{% unless show_all_tab or has_new_prints or has_core_prints %} is-active{% endunless %}" data-panel="sale" role="tabpanel">
        <div class="option-selector__btns variant-grid-compact">
          {% comment %} 3: Sale — in stock {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' -%}
              {%- if sibling.tags contains 'sale' and sibling.available -%}
                <a href="{{ sibling.url }}"
                  class="opt-label opt-label--image {% if sibling.handle == product.handle %}is-active{% endif %}"
                  data-color="{{ sibling.metafields.theme.cutline }}"
                  {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                  <div class="opt-label__tag product-label--sale">SALE</div>
                  <div class="overflow_hidden">
                    <div class="opt-label__media media">
                      {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                        {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- else -%}
                        {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}

          {% comment %} 4: All sold out — last {% endcomment %}
          {%- for sibling in sibs_collection.products -%}
            {%- unless sibling.tags contains 'hidden' and sibling.available -%}
              {%- unless sibling.available -%}
                {%- if sibling.tags contains 'sale' -%}
                  <a href="{{ sibling.url }}"
                    class="opt-label opt-label--image sold-out {% if sibling.handle == product.handle %}is-active{% endif %}"
                    data-color="{{ sibling.metafields.theme.cutline }}"
                    {% if sibling.handle == product.handle %}data-selected="true"{% endif %}>
                    <div class="overflow_hidden">
                      <div class="opt-label__media media">
                        <div class="sold-out-line"></div>
                        {%- if sibling.metafields.custom.swatch.value.image.value != blank -%}
                          {%- render 'image', image: sibling.metafields.custom.swatch.value.image.value, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- else -%}
                          {%- render 'image', image: sibling.images.first, sizes: img_sizes, widths: img_widths, custom_aspect_ratio: img_aspect_ratio, custom_crop: img_crop_align -%}
                        {%- endif -%}
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>{% comment %} end .sibling-tabs {% endcomment %}

{% endif %}

{%- unless product.has_only_default_variant -%}
  {%- if product.variants.size > 1 or block.settings.show_single -%}
    <script src="{{ 'variant-picker.js' | asset_url }}" defer></script>

    <variant-picker
        class="no-js-hidden"
        data-url="{{ product.url }}"
        data-update-url="{{ update_url | default: false }}"
        data-availability="{{ block.settings.dynamic_availability }}"
        data-availability-mode="{{ dynamic_availability_mode | default: 'selection' }}">
      {%- for option in product.options_with_values -%}
        {%- capture option_id %}{{ product_form_id }}-{{ forloop.index }}{% endcapture -%}
        {%- liquid
          assign is_color_selector = false
          assign is_variant_image_style = false
          assign show_size_chart = false
          assign is_dropdown = false

          if settings.swatch_source == 'theme' and settings.swatch_option_name contains option.name and settings.swatch_method == 'variant-images'
            assign is_color_selector = true
            assign is_variant_image_style = true
            assign option_index0 = forloop.index0
          elsif settings.swatch_source == 'theme' and settings.swatch_option_name contains option.name and settings.swatch_method == 'swatches'
            assign is_color_selector = true
          else
            assign native_swatch_options = option.values | where: 'swatch'
            if settings.swatch_source == 'native' and native_swatch_options.size > 0
              assign is_color_selector = true
              assign is_native_swatch_style = true
            endif
          endif

          if is_variant_image_style or is_native_swatch_style
            assign img_sizes = settings.swatch_picker_image_size | append: 'px'
            assign img_widths = settings.swatch_picker_image_size | times: 2 | append: ', ' | append: settings.swatch_picker_image_size
            if settings.swatch_style == 'icon_square'
              assign img_aspect_ratio = null
              assign img_crop_align = null
            else
              assign img_aspect_ratio = 1
              assign img_crop_align = settings.swatch_crop_align
            endif
          endif

          if is_color_selector
            if settings.swatch_style == 'dropdown'
              assign is_dropdown = true
            endif
          elsif block.settings.selector_style == 'dropdown'
            assign is_dropdown = true
          endif

          if block.settings.enable_size_chart and block.settings.size_chart_variant == option.name and block.settings.size_chart_page != blank
            assign show_size_chart = true
          endif
        -%}

        {%- if show_size_chart -%}
          {%- capture size_chart_link -%}
            <modal-opener class="no-js-hidden" data-modal="size-chart-{{ product.id }}-{{ section.id }}">
              <button type="button" class="link block text-sm size-chart-link" aria-haspopup="dialog">
                <span class="size-chart-link__icon">{%- render 'icon', icon: 'ruler', size: 'small' -%}</span>
                <span class="size-chart-link__text underline">{{- block.settings.size_chart_label -}}</span>
              </button>
            </modal-opener>
            <noscript>
              <a href="{{ block.settings.size_chart_page.url }}" class="link">{{ block.settings.size_chart_label }}</a>
            </noscript>
          {%- endcapture -%}
        {%- endif -%}

        {%- if is_dropdown -%}
          {%- if is_variant_image_style -%}
            <style>
              {%- for value in option.values -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[option_index0] == value -%}
                    #{{ option_id }} [data-swatch="{{ value | replace: '"', '\"' | downcase }}"] {
                      --swatch-background-color: transparent;
                      --swatch-background-image: url({{ variant.featured_media | image_url: width: 40, height: 40, crop: settings.swatch_crop_align }});
                    }
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </style>
          {%- endif -%}
          {%- capture selector_label -%}
            <label class="label" id="{{ option_id }}-label">{{- option.name -}}</label>
          {%- endcapture -%}
          <div class="option-selector" data-selector-type="dropdown" data-option="{{ option.name | escape }}">
            {%- if show_size_chart -%}
              <div class="flex justify-between">
                {{ selector_label }}
                {{ size_chart_link }}
              </div>
            {%- else -%}
              {{ selector_label }}
            {%- endif -%}
            {%- liquid
              if section.settings.select_first_variant or product.variants.size == 1
                assign selected_value = option.selected_value
              else
                if product.selected_variant
                  assign selected_value = option.selected_value
                else
                  assign selected_value = ''
                endif
              endif
            -%}
            <script src="{{ 'custom-select.js' | asset_url }}" defer></script>
            {% render 'custom-select',
              id: option_id,
              option_values: option.values,
              selected_value: selected_value,
              swatches: is_color_selector,
              native_swatches: is_native_swatch_style
            %}
          </div>
        {%- else -%}
          <fieldset class="option-selector size-selector" data-selector-type="listed" data-option="{{ option.name | escape }}">
            {%- if show_size_chart -%}
              <div class="flex justify-between">
                <legend class="label">{{- option.name -}}</legend>
                {{ size_chart_link }}
              </div>
            {%- else -%}
              <legend class="label">{{- option.name -}}{% if is_color_selector %}: <span class="option-selector__label-value js-color-text">{% if section.settings.select_first_variant or product.variants.size == 1 or product.selected_variant %}{{ option.selected_value }}{% endif %}</span>{% endif %}</legend>
            {%- endif -%}
            <div class="option-selector__btns flex flex-wrap">
              
              {%- for value in option.values -%}
                {%- assign value_index0 = forloop.index0 -%}
                <input type="radio" class="opt-btn visually-hidden focus-label js-option" name="{{ option_id }}-option" id="{{ option_id }}-opt-{{ value_index0 }}" value="{{ value | escape }}" required{% if section.settings.select_first_variant or product.variants.size == 1 or product.selected_variant %}{% if option.selected_value == value %} checked{% endif %}{% endif %}>
                {%- if is_variant_image_style -%}
                  
                  {%- for variant in product.variants -%}
                    {%- if variant.options[option_index0] == value -%}
                      <label class="opt-label opt-label--image" for="{{ option_id }}-opt-{{ value_index0 }}">
                        <div class="opt-label__media media">
                          {%- render 'image',
                            image: variant.featured_media,
                            sizes: img_sizes,
                            widths: img_widths,
                            custom_aspect_ratio: img_aspect_ratio,
                            custom_crop: img_crop_align
                          -%}
                        </div>
                        <span class="{% if settings.swatch_style != 'listed' %}visually-hidden {% endif %}js-value">{{ value }}</span>
                      </label>
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif settings.swatch_source == 'native' and value.swatch.image -%}
                  <label class="opt-label opt-label--image" for="{{ option_id }}-opt-{{ value_index0 }}">
                    <div class="opt-label__media media">
                      {%- render 'image',
                        image: value.swatch.image,
                        sizes: img_sizes,
                        widths: img_widths,
                        custom_aspect_ratio: img_aspect_ratio,
                        custom_crop: img_crop_align
                      -%}
                    </div>
                    <span class="{% if settings.swatch_style != 'listed' %}visually-hidden {% endif %}js-value">{{ value }}</span>
                  </label>

                {%- elsif settings.swatch_source == 'native' and value.swatch.color -%}
                  <label class="opt-label opt-label--swatch btn relative"
                    data-swatch="{{ value | replace: '"', '' | downcase }}"
                    for="{{ option_id }}-opt-{{ value_index0 }}"
                    style="--swatch-background-color: rgb({{ value.swatch.color.rgb }})">
                    <span class="{% if settings.swatch_style != 'listed' %}visually-hidden {% endif %}js-value">{{ value }}</span>
                  </label>

                {%- else -%}
                  {%- liquid
                    assign is_swatch = false
                    if is_color_selector and settings.swatch_method == 'swatches'
                      assign is_swatch = true
                    endif
                  -%}
                  <label class="{% if variant.available == false %}disabled{% endif %} opt-label {% if is_swatch %}opt-label--swatch{% else %}opt-label--btn{% endif %} btn relative text-center"{% if is_swatch %}
                    data-swatch="{{ value | replace: '"', '' | downcase }}"{% endif %}
                    for="{{ option_id }}-opt-{{ value_index0 }}" >
                    <span class="{% if is_swatch and settings.swatch_style != 'listed' %}visually-hidden {% endif %}js-value">{{ value }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {"variants": {{- product.variants | json -}},"formatted": {
          {%- for variant in product.variants -%}
            "{{ variant.id }}":{"price":{% if settings.product_currency_code_enabled %}{{ variant.price | money_with_currency | json }}{% else %}{{ variant.price | money | json }}{% endif %}
              {%- if variant.compare_at_price > variant.price -%}
                ,"compareAtPrice":{{ variant.compare_at_price | money | json -}}
              {%- endif -%}
              {%- if variant.unit_price_measurement -%}
                ,"unitPrice":{{ variant.unit_price | money | json -}}
              {%- endif -%}
              {%- if variant.inventory_management != nil and variant.inventory_quantity <= 0 -%}
                ,"inventory":"none"
              {%- endif -%}
            }{%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        }}
      </script>
    </variant-picker>

    <noscript>
      <div class="product-info__select"{% if product.has_only_default_variant %} hidden{% endif %}>
        <label class="label" for="variants-{{ product.id }}-{{ section.id }}">
          {{- 'products.product.product_variants' | t -}}
        </label>
        <div class="select relative">
          <select class="select w-full" id="variants-{{ product.id }}-{{ section.id }}" name="id" form="{{ product_form_id }}">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% if variant.available == false %}disabled{% endif %}>
                {{- variant.title -}}
                {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                - {{ variant.price | money | strip_html }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    </noscript>
  {%- endif -%}
{%- endunless -%}

<style>
  /* =============================================
   Sibling Tabs — add to custom product pages CSS
   ============================================= */



.sibling-tabs__nav {
  display: flex;
  gap: 4px;
  margin-bottom: 4px;
  border-bottom: 1px solid #D9E1E4;
}

.sibling-tabs__tab {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  padding: 8px 14px;
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 600;
  font-family: avenir-next-lt-pro, sofia-pro, sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #848484;
  transition: color 0.2s, border-color 0.2s;
}

.sibling-tabs__tab:hover {
  color: #4F676E;
}

.sibling-tabs__tab.is-active {
  color: #4F676E;
  border-bottom-color: #6A8B95;
}

.sibling-tabs__color-label {
  min-height: 1.2em;
  margin-top: 8px;
  margin-bottom: 4px;
  color: #1d1d1d;
  font-size: 1rem;
}
.sibling-tabs__color-label .js-color-label-prefix{
  display:inline;
}

.sibling-tabs__panel {
  display: none;
}

.sibling-tabs__panel.is-active {
  display: block;
}

/* Grid layout */
.sibling-tabs .option-selector__btns.variant-grid-compact {
  display: grid;
  grid-template-columns: repeat(auto-fill, 60px);
  gap: 10px;
  padding-top: 10px;
  margin: 0;
  justify-content: space-between;
}

/* Square swatches — fluid width, forced square via aspect-ratio */
.sibling-tabs .opt-label--image {
  aspect-ratio: 1 / 1;
  width: 100%;
  height: auto;
  border-radius: 4px;
  margin: 0;
  position: relative;
  display: block;
  box-sizing: border-box;
  border:none;
  min-width: unset;
  min-height: unset;
}

/* Active ring */
.sibling-tabs .opt-label--image.is-active:after {
  content: '';
  position: absolute;
  inset: 0;
  border: 2.5px solid #6A8B95 !important;
  border-radius: 4px;
  pointer-events: none;
  z-index: 2;
}

/* Default border */
.sibling-tabs .opt-label--image:after {
  content: '';
  position: absolute;
  inset: 0;
  border: 2px solid #D9E1E4;
  border-radius: 4px;
  pointer-events: none;
  z-index: 2;
}

.sibling-tabs .opt-label--image:hover:after {
  border: 2px solid #8EA7AF;
}

/* Sold-out states */
.sibling-tabs .opt-label--image.sold-out:hover:after {
  border-color: #D9E1E4;
}

.sibling-tabs .opt-label--image.is-active.sold-out:hover .sold-out-line {
  background-color: #6A8B95;
}

.sibling-tabs .opt-label--image .sold-out-line {
  background-color: #D9E1E4;
}

/* overflow_hidden fills the full swatch, no padding */
.sibling-tabs .opt-label--image .overflow_hidden {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 4px;
}

/* media fills overflow_hidden */
.sibling-tabs .opt-label--image .opt-label__media.media {
  position: absolute;
  inset: 0;
  height: 100%;
  width: 100%;
}



.sibling-tabs .sold-out .theme-img {
  opacity: 30%;
}

/* Bottom margin matches .option-selector */
.sibling-tabs {
  margin-bottom: 40px;
}

@media (min-width: 768px) {
  .sibling-tabs {
    margin-bottom: 32px;
  }
  .sibling-tabs .option-selector__btns.variant-grid-compact {
    gap: 10px;
  }
}

@media (max-width: 767px) {
  .sibling-tabs .option-selector__btns.variant-grid-compact {
    gap: 8px;
  }
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const siblingTabContainers = document.querySelectorAll("[data-sibling-tabs]");

    siblingTabContainers.forEach(function (container) {
      const tabs = container.querySelectorAll(".sibling-tabs__tab");
      const panels = container.querySelectorAll(".sibling-tabs__panel");
      const colorLabel = container.querySelector(".js-color-text-global");
      const allLabels = container.querySelectorAll(".opt-label");

      function getSelectedCutline() {
        const selected = container.querySelector(".opt-label[data-selected]");
        return selected ? selected.getAttribute("data-color") || "" : "";
      }

      function setColorLabel(text) {
        const prefix = container.querySelector(".js-color-label-prefix");
        const value = container.querySelector(".js-color-label-value");
        if (!prefix || !value) return;
        prefix.style.display = text ? "" : "none";
        value.textContent = text || "";
      }

      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          const target = this.getAttribute("data-tab");

          tabs.forEach(function (t) {
            t.classList.remove("is-active");
            t.setAttribute("aria-selected", "false");
          });
          panels.forEach(function (p) {
            p.classList.remove("is-active");
          });

          this.classList.add("is-active");
          this.setAttribute("aria-selected", "true");

          const targetPanel = container.querySelector('[data-panel="' + target + '"]');
          if (targetPanel) targetPanel.classList.add("is-active");

          setColorLabel(getSelectedCutline());
        });
      });

      allLabels.forEach(function (label) {
        label.addEventListener("mouseenter", function () {
          setColorLabel(this.getAttribute("data-color") || "");
        });
        label.addEventListener("mouseleave", function () {
          setColorLabel(getSelectedCutline());
        });
      });

      setColorLabel(getSelectedCutline());
    });
  });
</script>
