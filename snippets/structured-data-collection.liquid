{%- comment -%}
  Parameters:
  - collection {Object} - Collection object. Must be called from inside the
    section's {% paginate collection.products by ... %} block so
    collection.products/paginate reflect the current page and true total.

  Usage:
  {% render 'structured-data-collection', collection: collection %}
{%- endcomment -%}

{% capture item_list_json %}
  {%- for product in collection.products -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "url": {{ shop.url | append: product.url | json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{% endcapture %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": {{ shop.url | append: collection.url | json }},
  "description": {{ collection.description | strip_html | strip | truncate: 300 | json }},
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ paginate.items }},
    "itemListElement": [{{ item_list_json }}]
  }
}
</script>
