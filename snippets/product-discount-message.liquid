<div class="lightly-spaced-row not-in-quickbuy" style="margin-bottom: 0; pointer-events: auto;"><div class="product-info-block  text-box" style="--box-color: #fbeae5; --box-text-color: 174, 39, 0; pointer-events: auto;">
                
                  <div class=" rte cf">
                    {% assign cart_total_cents = cart.total_price %}


                    {% if cart_total_cents < 5000 %}
                      {% assign diff_cents = 5000 | minus: cart_total_cents %}
                      <p>
                        You're saving <strong>15%</strong> 🎉  <br>
                        Add ${{ diff_cents | money_without_currency }} more to unlock <strong>20% off</strong>.
                      </p>

                    {% elsif cart_total_cents < 9500 %}
                      {% assign diff_cents = 9500 | minus: cart_total_cents %}
                      <p>
                        You're saving <strong>20%</strong> 🎉  <br>
                        Add ${{ diff_cents | money_without_currency }} more to unlock <strong>25% off</strong>.
                      </p>

                    {% else %}
                      <p>
                        You've unlocked <strong>25% off <br> Our biggest Black Friday savings!</strong> 🎉
                      </p>
                    {% endif %}


                  </div>
                </div>
              </div>

              <script>
  function refreshDiscountMessage() {
    fetch(window.location.pathname + '?section_id=discount-message') // refresh snippet
      .then(response => response.text())
      .then(html => {
        document.getElementById('cart-discount-message').innerHTML = html;
      });
  }

  // Update on page load
  document.addEventListener('DOMContentLoaded', refreshDiscountMessage);

  // Listen for add-to-cart buttons
  document.querySelectorAll('form[action^="/cart/add"]').forEach(form => {
    form.addEventListener('submit', () => {
      setTimeout(refreshDiscountMessage, 500);
    });
  });
</script>