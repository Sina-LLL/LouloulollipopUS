{% if care_icons != blank %}
  <div class="product-material__icons-wrapper">
      {% for item in care_icons %}
        <div class="product-material-care__icons">
          {% if item.icon.value != blank %}
            <img src="{{ item.icon.value | image_url: width: 48 }}" alt="{{ item.title.value | escape }}" loading="lazy" height="40px" width="40px">
          {% endif %}
          <p>{{ item.title.value }}</p>
        </div>

      {% endfor %}
  </div>
{% endif %}
