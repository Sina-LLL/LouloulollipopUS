{% assign care_list = product.metafields.custom.care_instructions.value %}

{% if care_list != blank %}
  <div class="product-care-instructions">
    <h3>Care Instructions</h3>
    <ul class="care-icons">
      {% for item in care_list %}
        <li class="care-item">
          {% if item.icon != blank %}
            <img src="{{ item.icon | image_url: width: 64 }}" alt="{{ item.label }}" loading="lazy">
          {% endif %}
          <p>{{ item.title }}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}