{% comment %}
  Award badges — circular seals overlaid on the main PDP image.
  Sourced from product_awards metaobjects linked via
  product.metafields.custom.product_template.value.product_awards
{% endcomment %}

{%- assign award_template = product.metafields.custom.product_template.value -%}
{%- assign awards = award_template.product_awards.value -%}

{%- if awards != blank and awards.size > 0 -%}
  <div class="product-award-badges{% if context == 'slide' %} product-award-badges--slide{% endif %}">
    {%- for award in awards -%}
      {%- assign badge_color = award.color.value | default: '#F2B321' -%}
      <div class="product-award-badge" style="--award-badge-color: {{ badge_color }};">
        <span class="product-award-badge__publication">{{ award.publication.value }}</span>
        <span class="product-award-badge__name">{{ award.awards_name.value }}</span>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
