{%- comment -%}
  Parameters:
  - product {Object} - Product object.
  - current_variant {Object} - Current variant object.

  Usage:
  {% render 'structured-data-product', product: product, current_variant: current_variant %}
{%- endcomment -%}

{%- liquid
  assign schema_category = product.type
  if product.category != blank
    assign schema_category = product.category.ancestors | map: 'name' | reverse | join: ' > '
    if schema_category != blank
      assign schema_category = schema_category | append: ' > ' | append: product.category.name
    else
      assign schema_category = product.category.name
    endif
  endif

  assign rating_count = product.metafields.reviews.rating_count | plus: 0
  assign rating_value = product.metafields.reviews.rating.value

  if product.metafields.custom.material_new.value.material_name.value != blank
    assign material_value = product.metafields.custom.material_new.value.material_name.value
  elsif product.tags contains 'TENCEL'
    assign material_value = 'TENCEL Lyocell'
  elsif product.tags contains 'muslin'
    assign material_value = '100% Organic Muslin Cotton'
  elsif product.tags contains 'silicone'
    assign material_value = '100% Food-Grade Silicone'
  elsif product.tags contains 'waffle'
    assign material_value = 'TENCEL Lyocell Waffle Knit'
  else
    assign material_value = product.type
  endif
-%}

{% capture image_list_json %}
  {%- for image in product.images -%}
    {{ image | image_url: width: image.width | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{% endcapture %}

{% comment %} ========== PRODUCT SCHEMA ========== {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [{{ image_list_json }}],
  "description": {{ product.description | strip_html | strip | truncate: 300 | json }},
  "sku": {{ current_variant.sku | json }},
  {%- if schema_category != blank %}
  "category": {{ schema_category | json }},
  {%- endif %}
  "brand": {
    "@type": "Brand",
    "name": {{ shop.name | json }}
  },
  {%- if material_value != blank %}
  "material": {{ material_value | json }},
  {%- endif %}
  "offers": {
    "@type": "AggregateOffer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "lowPrice": "{{ product.price_min | divided_by: 100.0 }}",
    "highPrice": "{{ product.price_max | divided_by: 100.0 }}",
    "offerCount": {{ product.variants.size }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- if rating_count > 0 -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating_value }}",
    "reviewCount": "{{ rating_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>
