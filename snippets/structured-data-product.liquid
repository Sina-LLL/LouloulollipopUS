{%- comment -%}
  Parameters:
  - product {Object} - Product object.
  - current_variant {Object} - Current variant object.

  Usage:
  {% render 'structured-data-product', product: product, current_variant: current_variant %}
{%- endcomment -%}

{%- liquid
  assign rating_count = product.metafields.reviews.rating_count | plus: 0
  assign rating_value = product.metafields.reviews.rating.value

  if product.metafields.custom.material != blank
    assign material_raw = product.metafields.custom.material.value
    if material_raw.first != blank
      assign material_value = material_raw | join: ', '
    else
      assign material_value = material_raw | remove: '["' | remove: '"]' | remove: '[' | remove: ']'
    endif
  elsif product.tags contains 'TENCEL'
    assign material_value = 'TENCEL Lyocell'
  elsif product.tags contains 'muslin'
    assign material_value = '100% Organic Muslin Cotton'
  elsif product.tags contains 'silicone'
    assign material_value = '100% Food-Grade Silicone'
  elsif product.tags contains 'waffle'
    assign material_value = 'TENCEL Lyocell Waffle Knit'
  else
    assign material_value = product.type
  endif
-%}

{% capture image_list_json %}
  {%- for image in product.images -%}
    {{ image | image_url: width: image.width | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{% endcapture %}

{% comment %} ========== PRODUCT SCHEMA ========== {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [{{ image_list_json }}],
  "description": {{ product.description | strip_html | strip | truncate: 300 | json }},
  "sku": {{ current_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ shop.name | json }}
  },
  "material": {{ material_value | json }},
  "offers": {
    "@type": "AggregateOffer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "lowPrice": "{{ product.price_min | divided_by: 100.0 }}",
    "highPrice": "{{ product.price_max | divided_by: 100.0 }}",
    "offerCount": {{ product.variants.size }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- if rating_count > 0 -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating_value }}",
    "reviewCount": "{{ rating_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>
